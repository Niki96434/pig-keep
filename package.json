{
  "name": "pig-keep-root",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:front": "npm run dev --workspace=frontend",
    "dev:back": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "test": "npm run test --workspaces"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "msw@2.15.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
